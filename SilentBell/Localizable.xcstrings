    "No sound, nothing on screen. Only you feel it, even in Do Not Disturb.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ton, nichts auf dem Display. Nur du spürst es – auch im Nicht-stören-Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sound, nothing on screen. Only you feel it, even in Do Not Disturb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sonido y sin nada en pantalla. Solo tú lo notas, incluso en modo No molestar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun son, rien à l'écran. Vous seul le sentez, même en mode Ne pas déranger."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音もなく、画面にも何も表示されません。おやすみモード中でも、感じるのはあなただけです。"
          }
        }
      }
    },
    "Paused": {
      "extractionState": "manual",
      "localizations": {
