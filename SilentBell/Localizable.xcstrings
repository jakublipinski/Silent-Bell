          }
        }
      }
    },
    "Random taps on your wrist — a prompt to notice where your attention is. Predictable reminders are ignored over time; unpredictable ones aren't.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zufällige Impulse am Handgelenk – ein Anstoß, zu bemerken, wo deine Aufmerksamkeit gerade ist. Vorhersehbare Erinnerungen werden mit der Zeit ignoriert, unvorhersehbare nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Random taps on your wrist — a prompt to notice where your attention is. Predictable reminders are ignored over time; unpredictable ones aren't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toques aleatorios en la muñeca: un aviso para notar dónde está tu atención. Los recordatorios predecibles se acaban ignorando; los impredecibles, no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des impulsions aléatoires au poignet — une invitation à remarquer où se trouve votre attention. Les rappels prévisibles finissent par être ignorés ; les imprévisibles, non."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手首に届くランダムな振動。いま自分の注意がどこにあるかに気づくための合図です。予測できるリマインダーはやがて無視されますが、予測できないものは違います。"
          }
        }
      }
    },
