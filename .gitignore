# Private operational notes: team ID, Apple ID, device UDID, credential pointers.
OPERATIONS.md

# Local machine values sourced by run.sh (team ID, device UDID).
secrets.env

# Generated by XcodeGen — never hand-edited, never committed.
SilentBell.xcodeproj/

# Build output and logs. The glob is deliberate: naming each directory
# individually let build-archive/ through, and a signed .xcarchive carries the
# team ID and the paired device UDIDs.
build*/
*.log
*.ipa
*.xcarchive
DerivedData/

# macOS
.DS_Store

# Local Claude Code config (contains device UDID and local paths).
.claude/

# Generated by XcodeGen from project.yml.
SilentBell/Info.plist

# Distribution profile downloaded from the developer portal — not shared.
*.mobileprovision
